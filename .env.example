# 선택 사항: .env 없이 docker compose up -d 로 기본 설치합니다.
# 값을 바꾸려면 이 파일을 .env 로 복사하세요. .env 는 커밋하지 않습니다.
# 웹은 호스트의 모든 IPv4 주소에 공개하며 DB/프록시는 Compose 내부에서 사용합니다.
# 이 PC에서만 접속하려면 ARTEX_BIND_IP=127.0.0.1 로 바꾸세요.
ARTEX_BIND_IP=0.0.0.0
ARTEX_PORT=8787
ARTEX_LANG=ko

# 새 PostgreSQL 볼륨의 초기값. 기존 볼륨의 비밀번호는 env 변경으로 바뀌지 않습니다.
POSTGRES_USER=artex
POSTGRES_PASSWORD=artex-local-db
POSTGRES_DB=artex

# 관리자 ID는 ARTEX. 첫 실행에만 적용하며 저장된 비밀번호를 덮어쓰지 않습니다.
ARTEX_ADMIN_PASSWORD=artex1234

# 선택 사항: 웹에서 API 키/모델 또는 ChatGPT 구독 계정을 설정할 수 있습니다.
# ChatGPT OAuth 토큰은 .env 에 넣지 않고 artex-auth 볼륨에 보관합니다.
OPENAI_API_KEY=
ARTEX_LLM_MODEL=
ARTEX_LLM_PROXY=

# 소스 이미지 태그와 화면에 표시할 버전입니다. v0.1.1 소스 배포는 0.1.1로 지정하세요.
# 개발 빌드는 docker-local을 사용하며, 값 변경 후 docker compose up -d --build 로 다시 빌드합니다.
ARTEX_BUILD_VERSION=docker-local
