# scripts/prepare-mcp.py metasploit init --network <ARTEX 네트워크>로
# .local/mcp/metasploit/.env를 생성한다. 직접 작성할 경우 아래 빈 값을 채운다.
# docker inspect <ARTEX 컨테이너> --format '{{json .NetworkSettings.Networks}}'로 확인한다.
ARTEX_NETWORK=
MSF_MCP_AUTH_TOKEN=
MSF_POSTGRES_PASSWORD=

# false: 조회 허용. true: 모듈 검사·실행과 세션 입력·종료도 허용.
# false여도 실행 도구 이름이 목록에 표시될 수 있으며 실제 호출을 서버가 거절한다.
# master와 릴리스의 기본값은 false다. 실습 실행을 허용하려면 true로 지정한다.
MSF_MCP_DANGEROUS_ACTIONS=false
