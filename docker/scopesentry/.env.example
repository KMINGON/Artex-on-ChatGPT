# scripts/prepare-mcp.py scopesentry init --network <ARTEX 네트워크>로
# .local/mcp/scopesentry/.env와 초기 상태 파일을 생성한다.
# docker inspect <ARTEX 컨테이너> --format '{{json .NetworkSettings.Networks}}'로 확인한다.
ARTEX_NETWORK=
# server-config.yaml, server-plugin-key, server-password가 있는 디렉터리의 절대 경로.
SCOPESENTRY_STATE_DIR=
SCOPESENTRY_BIND_IP=127.0.0.1
SCOPESENTRY_PORT=18083
SCOPESENTRY_NODE_NAME=artex-scopesentry-node
SCOPESENTRY_MONGO_USER=scopesentry
SCOPESENTRY_MONGO_PASSWORD=
SCOPESENTRY_REDIS_PASSWORD=
